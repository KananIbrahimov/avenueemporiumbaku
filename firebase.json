{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": [
    {
      "target": "magaza",
      "public": "public",
      "ignore": ["**/.*"],
      "cleanUrls": true,
      "headers": [
        { "source": "**/*.@(js|css|html|webmanifest)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
        { "source": "/admin/**", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
      ]
    },
    {
      "target": "admin",
      "public": "public",
      "ignore": ["**/.*"],
      "cleanUrls": true,
      "redirects": [{ "source": "/", "destination": "/admin/", "type": 302 }],
      "headers": [
        { "source": "**", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
        { "source": "**/*.@(js|css|html|webmanifest)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
      ]
    }
  ],
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
